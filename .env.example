# ===== Claude (Anthropic API) =====
# المفتاح من console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# النموذج المستخدم في الحوار والملخص
CLAUDE_MODEL=claude-opus-5-5

# ===== بيانات المكتب (تظهر للعميل) =====
OFFICE_NAME=مكتب المحاماة
LAWYER_NAME=المحامي
# مواعيد العمل وأي معلومة تريد أن يعرفها البوت (سطر واحد)
OFFICE_INFO=أوقات العمل من الأحد إلى الخميس، من 9 صباحًا إلى 5 مساءً.

# ===== حدود الحوار =====
# أقصى عدد لردود البوت في المحادثة الواحدة قبل تحويلها للمحامي
MAX_REPLIES=10
# ثوانٍ ينتظرها البوت ليجمع رسائل العميل المتتابعة قبل الرد
DEBOUNCE_SECONDS=8
# بعد كم يوم من التحويل تُفتح محادثة استقبال جديدة لو راسل العميل مجددًا
NEW_INTAKE_AFTER_DAYS=7

# ===== البريد (Gmail) =====
# بريد المحامي الذي يستقبل الملخصات
LAWYER_EMAIL=
# حساب Gmail المرسِل وكلمة مرور التطبيقات (App Password) — ليست كلمة المرور العادية
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ===== أرقام لا يرد عليها البوت (رقمك الشخصي مثلًا) — بصيغة دولية بلا + وتفصل بفاصلة =====
IGNORE_NUMBERS=
